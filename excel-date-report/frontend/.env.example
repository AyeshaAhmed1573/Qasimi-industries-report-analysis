# Leave empty (or delete this file) for local dev — Vite's dev-server proxy
# in vite.config.js forwards /api to http://localhost:4000 automatically.
#
# For a deployed frontend (e.g. on Vercel), set this to your deployed
# backend's base URL, no trailing slash:
# VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=
